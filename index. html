<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy birthday Roseannn</title>
<link href="https://fonts.googleapis.com/css2?family=Chewy&family=Pacifico&family=Sniglet:wght@800&display=swap" rel="stylesheet">
<style>
:root{
  --plum:#2a1233; --plum2:#55235a;
  --rose:#e8557f; --rose-d:#b93a62; --gold:#f4c556; --gold-d:#c9962c;
  --choc:#4a2618; --ganache:#2a1209; --cream:#fbe9d0;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*{box-sizing:border-box}
body{
  margin:0;height:100%;display:flex;align-items:center;justify-content:center;overflow:hidden;
  background:radial-gradient(ellipse at 50% 70%,var(--plum2),var(--plum) 70%);
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--cream);
  -webkit-tap-highlight-color:transparent;
}
.wrap{display:flex;flex-direction:column;align-items:center;gap:6px}
.scene{
  position:relative;width:300px;height:420px;border:0;padding:0;background:none;cursor:pointer;
  font:inherit;color:inherit;
}
.scene:focus-visible{outline:3px solid var(--gold);outline-offset:6px;border-radius:16px}
.glow{position:absolute;left:50%;bottom:90px;width:320px;height:320px;margin-left:-160px;border-radius:50%;
  background:radial-gradient(circle,rgba(255,200,120,.45),transparent 65%);opacity:0;transition:opacity 1s .9s}
.open .glow{opacity:1}

/* gift */
.gift{position:absolute;left:0;right:0;bottom:0;height:260px;z-index:3;animation:wiggle 3.2s ease-in-out infinite;transform-origin:50% 100%}
.open .gift{animation:none}
.gift{pointer-events:none}
.gift .body{pointer-events:auto}
@keyframes wiggle{0%,78%,100%{transform:rotate(0)}82%{transform:rotate(-2.5deg)}86%{transform:rotate(2.5deg)}90%{transform:rotate(-1.5deg)}94%{transform:rotate(1deg)}}
.shadow{position:absolute;left:50%;bottom:-8px;width:260px;height:20px;margin-left:-130px;border-radius:50%;background:rgba(0,0,0,.35);filter:blur(6px)}
.body{
  position:absolute;left:50%;bottom:30px;width:230px;height:150px;margin-left:-115px;z-index:3;
  background:linear-gradient(90deg,var(--rose-d),var(--rose) 30%,var(--rose) 70%,var(--rose-d));
  border-radius:4px 4px 8px 8px;overflow:hidden;
}
.body::before{content:"";position:absolute;top:0;bottom:0;left:50%;width:34px;margin-left:-17px;
  background:linear-gradient(90deg,var(--gold-d),var(--gold) 40%,var(--gold-d))}
.body::after{content:"";position:absolute;left:0;right:0;top:62%;height:24px;
  background:linear-gradient(var(--gold-d),var(--gold) 40%,var(--gold-d));opacity:.95}
.dots{position:absolute;inset:0;background:radial-gradient(circle,rgba(255,255,255,.28) 3px,transparent 4px) 0 0/26px 26px;opacity:.55}
.lid{
  position:absolute;left:50%;bottom:172px;width:254px;height:56px;margin-left:-127px;z-index:4;
  background:linear-gradient(90deg,#a53056,#d9466f 30%,#d9466f 70%,#a53056);border-radius:8px;
  box-shadow:0 6px 0 rgba(0,0,0,.18);
}
.lid::before{content:"";position:absolute;top:0;bottom:0;left:50%;width:34px;margin-left:-17px;
  background:linear-gradient(90deg,var(--gold-d),var(--gold) 40%,var(--gold-d))}
.bow{position:absolute;left:50%;top:-34px;width:0;height:0}
.loop{position:absolute;width:56px;height:40px;border:11px solid var(--gold);border-radius:50%;top:-14px;
  box-shadow:inset 0 0 0 2px var(--gold-d)}
.loop.l{right:2px;transform:rotate(-24deg);transform-origin:100% 50%}
.loop.r{left:2px;transform:rotate(24deg);transform-origin:0 50%}
.knot{position:absolute;left:-12px;top:-10px;width:24px;height:24px;border-radius:7px;background:var(--gold);
  box-shadow:inset 0 -4px 0 var(--gold-d)}
.tail{position:absolute;top:8px;width:14px;height:36px;background:var(--gold);box-shadow:inset 0 -4px 0 var(--gold-d)}
.tail.l{left:-16px;transform:rotate(14deg);clip-path:polygon(0 0,100% 0,100% 100%,50% 82%,0 100%)}
.tail.r{left:2px;transform:rotate(-14deg);clip-path:polygon(0 0,100% 0,100% 100%,50% 82%,0 100%)}
.open .lid{animation:lidOff 1.1s cubic-bezier(.5,0,.7,.4) forwards}
@keyframes lidOff{
  0%{transform:none}
  18%{transform:translateY(-8px) rotate(-1.5deg)}
  100%{transform:translate(-150px,-210px) rotate(-38deg);opacity:0}
}

/* cake */
.cake{
  position:absolute;left:50%;bottom:36px;width:220px;height:210px;margin-left:-110px;z-index:2;
  transform-origin:50% 100%;transform:scale(.52);
}
.open .cake{animation:rise 1.5s .65s cubic-bezier(.3,1.4,.5,1) forwards}
@keyframes rise{from{transform:translateY(0) scale(.52)}to{transform:translateY(-112px) scale(1)}}
.plate{position:absolute;left:0;bottom:0;width:220px;height:14px;border-radius:50%;background:linear-gradient(#fff,#d9cfe0);box-shadow:0 3px 0 rgba(0,0,0,.2)}
.tier{position:absolute;left:50%;border-radius:8px;
  background:linear-gradient(90deg,#33170d,var(--choc) 45%,#33170d)}
.tier::before{content:"";position:absolute;top:-11px;left:0;right:0;height:24px;border-radius:50%;background:var(--ganache)}
.tier::after{content:"";position:absolute;top:2px;left:0;right:0;height:30px;
  background:linear-gradient(var(--ganache),var(--ganache)) 0 0/100% 10px no-repeat,
             radial-gradient(circle at 11px 10px,var(--ganache) 8px,transparent 9px) 0 0/22px 30px repeat-x}
.t1{width:200px;height:84px;bottom:8px;margin-left:-100px}
.t2{width:140px;height:58px;bottom:90px;margin-left:-70px}
.pipe{position:absolute;left:0;right:0;bottom:-6px;height:16px;
  background:radial-gradient(circle at 10px 8px,var(--cream) 8px,transparent 9px) 0 0/20px 16px repeat-x}
.berry{position:absolute;width:16px;height:16px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ff8aa8,#d12a5a 70%);top:-18px;z-index:2}
.candles{position:absolute;left:50%;bottom:140px;width:100px;margin-left:-50px;height:46px;z-index:1}
.candle{position:absolute;bottom:0;width:10px;height:30px;border-radius:3px;
  background:repeating-linear-gradient(135deg,var(--c) 0 6px,#fff 6px 12px)}
.flame{position:absolute;left:50%;bottom:100%;width:10px;height:17px;margin:0 0 3px -5px;opacity:0;
  border-radius:50% 50% 50% 50%/62% 62% 38% 38%;
  background:radial-gradient(ellipse at 50% 75%,#fff6b0 15%,#ffbe3d 55%,#ff7a1a);
  box-shadow:0 0 14px 5px rgba(255,190,70,.55);transform-origin:50% 100%}
.open .flame{animation:on .4s 2s forwards,flick .35s 2.4s ease-in-out infinite alternate}
@keyframes on{to{opacity:1}}
@keyframes flick{from{transform:scale(1,1) rotate(-3deg)}to{transform:scale(.88,1.1) rotate(3deg)}}

/* text + confetti */
.hint{position:relative;overflow:hidden;width:min(300px,88vw);min-height:84px;margin:6px 0 0;padding:26px 20px 11px;
  display:flex;align-items:center;justify-content:center;text-align:center;
  font-family:"Sniglet","Chewy","Pacifico",cursive;font-weight:800;font-size:17px;line-height:1.25;letter-spacing:.3px;color:#fff1dc;
  background:linear-gradient(90deg,#33170d,var(--choc) 45%,#33170d);border-radius:16px;box-shadow:0 4px 0 rgba(0,0,0,.28)}
.hint::before{content:"";position:absolute;top:0;left:0;right:0;height:24px;
  background:linear-gradient(#ffc2d6,#ffc2d6) 0 0/100% 9px no-repeat,
             radial-gradient(circle at 11px 9px,#ffc2d6 8px,transparent 9px) 0 0/22px 24px repeat-x}
.scene:not(.open)~.hint{animation:pulse 1.6s ease-in-out infinite}
@keyframes pulse{50%{opacity:.45}}
.piece{position:fixed;top:0;width:9px;height:14px;z-index:9;pointer-events:none;border-radius:2px;
  animation:fall var(--d) cubic-bezier(.2,.6,.4,1) forwards}
@keyframes fall{
  0%{transform:translate(0,0) rotate(0);opacity:1}
  100%{transform:translate(var(--x),105vh) rotate(var(--r));opacity:1}
}
.hit{position:absolute;inset:-34px -9px -4px;display:block}
.open .candle{cursor:pointer}
.candle:focus-visible{outline:2px solid var(--gold);outline-offset:4px}
.open .candle.out .flame{animation:snuff .3s 0s forwards !important}
@keyframes snuff{to{opacity:0;transform:scale(.2)}}
.smoke{position:absolute;left:50%;bottom:100%;width:8px;height:8px;margin-left:-4px;border-radius:50%;
  background:rgba(255,255,255,.55);filter:blur(3px);pointer-events:none;animation:smoke 1.6s ease-out forwards}
@keyframes smoke{to{transform:translate(8px,-44px) scale(3.5);opacity:0}}
.tools{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;align-items:center;font-size:13px;min-height:30px;max-width:320px}
.tools button,.tools label{position:relative;font:inherit;color:var(--cream);background:none;border:1px solid rgba(251,233,208,.5);border-radius:999px;padding:5px 12px;cursor:pointer}
.tools button:focus-visible,.tools label:focus-within{outline:2px solid var(--gold);outline-offset:2px}
.balloon{position:fixed;bottom:-140px;width:54px;height:68px;z-index:15;pointer-events:none;
  border-radius:50% 50% 48% 48%/55% 55% 45% 45%;
  background:radial-gradient(ellipse at 30% 26%,rgba(255,255,255,.7) 0 6px,transparent 7px),
             radial-gradient(circle at 40% 35%,var(--b),var(--bd) 92%);
  animation:floatUp var(--d) linear forwards}
.balloon::before{content:"";position:absolute;left:50%;bottom:-7px;margin-left:-5px;border:5px solid transparent;border-top:0;border-bottom:9px solid var(--bd)}
.balloon::after{content:"";position:absolute;left:50%;top:100%;margin:2px 0 0 -1px;width:2px;height:56px;background:rgba(255,255,255,.55)}
@keyframes floatUp{
  0%{transform:translate(0,0) rotate(-4deg)}
  25%{transform:translate(var(--dx),-30vh) rotate(4deg)}
  50%{transform:translate(calc(var(--dx)*-.5),-65vh) rotate(-4deg)}
  100%{transform:translate(var(--dx),calc(-100vh - 280px)) rotate(3deg)}
}
.piece.pop{animation:pop var(--d) linear forwards}
@keyframes pop{
  0%{transform:translate(0,0) rotate(0);animation-timing-function:cubic-bezier(.1,.7,.3,1)}
  35%{transform:translate(var(--px),var(--py)) rotate(var(--r1));animation-timing-function:cubic-bezier(.45,0,.85,.6)}
  100%{transform:translate(var(--fx),var(--fy)) rotate(var(--r))}
}
.surprise{position:fixed;left:50%;top:50%;z-index:20;width:min(88vw,340px);padding:24px 16px 22px;text-align:center;
  background:linear-gradient(#fffaf0,var(--cream));border:4px solid var(--gold);border-radius:22px;
  box-shadow:0 14px 40px rgba(0,0,0,.45);transform:translate(-50%,-50%) scale(0);opacity:0;pointer-events:none;cursor:pointer}
.surprise.show{pointer-events:auto;animation:surpriseIn .9s cubic-bezier(.3,1.5,.5,1) forwards}
.surprise.show.bye{animation:surpriseOut .35s ease-in forwards}
@keyframes surpriseIn{from{transform:translate(-50%,-50%) scale(0) rotate(-8deg);opacity:0}to{transform:translate(-50%,-50%) scale(1) rotate(0);opacity:1}}
@keyframes surpriseOut{from{transform:translate(-50%,-50%) scale(1);opacity:1}to{transform:translate(-50%,-50%) scale(.6);opacity:0}}
.surprise h1{margin:0;font-family:"Chewy","Pacifico",cursive;font-weight:400;font-size:clamp(30px,10vw,44px);
  line-height:1.05;color:#d4153b;text-shadow:0 2px 0 #fff,3px 3px 0 rgba(212,21,59,.22)}
.surprise p{margin:12px 0 0;font-family:"Pacifico",cursive;font-size:21px;color:#d4153b}
@media (prefers-reduced-motion:reduce){.surprise.show{animation-duration:.01s}}
@media (max-width:340px){.scene{transform:scale(.85)}}
@media (prefers-reduced-motion:reduce){
  .gift{animation:none}.scene:not(.open)~.hint{animation:none}
  .open .cake{animation-duration:.01s;animation-delay:0s}.open .lid{animation-duration:.01s}
  .open .flame{animation:on .01s forwards}
}
</style>
</head>
<body>
<div class="wrap">
  <div class="scene" id="scene" role="button" tabindex="0" aria-label="Birthday gift. Tap to open.">
    <div class="glow"></div>

    <div class="cake">
      <div class="plate"></div>
      <div class="tier t1"><div class="pipe"></div></div>
      <div class="tier t2"><div class="pipe"></div></div>
      <div class="candles">
        <div class="candle" role="button" tabindex="0" aria-label="Blow out candle 1" style="left:16px;--c:#e8557f"><i class="hit"></i><div class="flame"></div></div>
        <div class="candle" role="button" tabindex="0" aria-label="Blow out candle 2" style="left:45px;--c:#f4c556;height:36px"><i class="hit"></i><div class="flame" style="animation-delay:2.1s,2.5s"></div></div>
        <div class="candle" role="button" tabindex="0" aria-label="Blow out candle 3" style="left:74px;--c:#8ad0c4"><i class="hit"></i><div class="flame" style="animation-delay:2.2s,2.45s"></div></div>
      </div>
    </div>

    <div class="gift">
      <div class="shadow"></div>
      <div class="body"><div class="dots"></div></div>
      <div class="lid">
        <div class="bow"><div class="tail l"></div><div class="tail r"></div><div class="loop l"></div><div class="loop r"></div><div class="knot"></div></div>
      </div>
    </div>
  </div>
  <p class="hint" id="hint" aria-live="polite">tap the gift to open it</p>

</div>

<div class="surprise" id="surprise" aria-hidden="true">
  <h1>HAPPY BIRTHDAY ROSEANN!!</h1>
  <p>Lovelots by Andreee</p>
</div>

<script>
(function(){
  var scene=document.getElementById('scene'), hint=document.getElementById('hint');
  var colors=['#e8557f','#f4c556','#8ad0c4','#fbe9d0','#b48cf0','#ff9f5a'];
  var calm=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function confetti(){
    if(calm) return;
    var r=scene.getBoundingClientRect(), cx=r.left+r.width/2;
    for(var i=0;i<46;i++){
      var p=document.createElement('i');
      p.className='piece';
      p.style.left=(cx+(Math.random()*160-80))+'px';
      p.style.top=(r.top+170+Math.random()*30)+'px';
      p.style.background=colors[i%colors.length];
      p.style.setProperty('--x',(Math.random()*360-180)+'px');
      p.style.setProperty('--r',(Math.random()*900-450)+'deg');
      p.style.setProperty('--d',(2.4+Math.random()*1.6)+'s');
      document.body.appendChild(p);
      setTimeout(function(el){el.remove()},4200,p);
    }
  }

  var count=0, rainT=null, rainStart=null, balloonT=null, balloonStart=null;
  function piece(cls,left,top,vars,dur,i,delay){
    var p=document.createElement('i');
    p.className='piece '+cls;
    p.style.left=left+'px'; p.style.top=top+'px';
    p.style.background=colors[i%colors.length];
    p.style.animationDelay=(delay||0)+'s';
    for(var k in vars) p.style.setProperty(k,vars[k]);
    p.style.setProperty('--d',dur+'s');
    p.addEventListener('animationend',function(){p.remove();count--;});
    document.body.appendChild(p); count++;
  }
  function sidePop(){
    if(calm) return;
    var h=window.innerHeight, w=window.innerWidth;
    [1,-1].forEach(function(side){
      for(var i=0;i<30;i++){
        var px=side*(70+Math.random()*Math.min(230,w*.45));
        piece('pop',side>0?-6:w-3,h*.62,{
          '--px':px+'px','--py':-(160+Math.random()*Math.min(300,h*.4))+'px',
          '--fx':(px*1.35+(Math.random()*60-30))+'px','--fy':(h*.5)+'px',
          '--r1':(Math.random()*360)+'deg','--r':(Math.random()*900-450)+'deg'
        },2.3+Math.random()*1,i+(side>0?0:2),Math.random()*.15);
      }
    });
  }
  function startRain(){
    if(calm) return;
    clearInterval(rainT);
    rainT=setInterval(function(){
      if(document.hidden||count>150) return;
      for(var j=0;j<2;j++){
        piece('rain',Math.random()*window.innerWidth,-20,{
          '--x':(Math.random()*120-60)+'px','--r':(Math.random()*900-450)+'deg'
        },4+Math.random()*3,Math.floor(Math.random()*6),0);
      }
    },170);
  }
  var bPairs=[['#e8557f','#b93a62'],['#f4c556','#c9962c'],['#8ad0c4','#4fa597'],['#b48cf0','#8559c9'],['#ff9f5a','#d9701f']], bCount=0;
  function balloon(delay){
    var b=document.createElement('i'), c=bPairs[Math.floor(Math.random()*bPairs.length)];
    b.className='balloon';
    b.style.left=(Math.random()*Math.max(40,window.innerWidth-70))+'px';
    b.style.animationDelay=(delay||0)+'s';
    b.style.setProperty('--b',c[0]); b.style.setProperty('--bd',c[1]);
    b.style.setProperty('--dx',(Math.random()*80-40)+'px');
    b.style.setProperty('--d',(8+Math.random()*4)+'s');
    b.addEventListener('animationend',function(){b.remove();bCount--;});
    document.body.appendChild(b); bCount++;
  }
  function startBalloons(){
    if(calm) return;
    for(var i=0;i<8;i++) balloon(i*.45);
    clearInterval(balloonT);
    balloonT=setInterval(function(){ if(!document.hidden&&bCount<14) balloon(0); },1100);
  }
  function stopBalloons(){
    clearTimeout(balloonStart); clearInterval(balloonT);
    [].slice.call(document.querySelectorAll('.balloon')).forEach(function(b){b.remove();});
    bCount=0;
  }
  function stopRain(){
    stopBalloons();
    clearTimeout(rainStart); clearInterval(rainT);
    [].slice.call(document.querySelectorAll('.piece')).forEach(function(p){p.remove();});
    count=0;
  }

  var candles=[].slice.call(document.querySelectorAll('.candle')),
      surprise=document.getElementById('surprise'), lit=false, timer=null, ac=null;

  function chime(){
    try{
      ac=ac||new (window.AudioContext||window.webkitAudioContext)();
      [523.25,659.25,783.99,1046.5,783.99,1046.5].forEach(function(fq,i){
        var t=ac.currentTime+i*.22, o=ac.createOscillator(), g=ac.createGain();
        o.type='triangle'; o.frequency.value=fq;
        g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(.25,t+.02);
        g.gain.exponentialRampToValueAtTime(.001,t+.9);
        o.connect(g); g.connect(ac.destination); o.start(t); o.stop(t+1);
      });
    }catch(e){}
  }

  function celebrate(){
    if(!lit) return;
    hint.textContent='make a wish! tap the gift to start over';
    confetti();
    surprise.setAttribute('aria-hidden','false');
    surprise.classList.add('show');
    balloonStart=setTimeout(startBalloons,900);
  }
  surprise.addEventListener('click',function(){
    surprise.classList.add('bye');
    setTimeout(function(){
      surprise.classList.remove('show','bye');
      surprise.setAttribute('aria-hidden','true');
    },350);
  });

  function blow(c){
    if(!lit||c.classList.contains('out')) return;
    c.classList.add('out');
    var s=document.createElement('i'); s.className='smoke'; c.appendChild(s);
    if(candles.every(function(x){return x.classList.contains('out');})) setTimeout(celebrate,500);
  }
  candles.forEach(function(c){
    c.addEventListener('click',function(e){e.stopPropagation();blow(c);});
    c.addEventListener('keydown',function(e){
      if(e.key==='Enter'||e.key===' '){e.preventDefault();e.stopPropagation();blow(c);}
    });
  });

  function resetGift(){
    clearTimeout(timer); lit=false; stopRain();
    candles.forEach(function(c){c.classList.remove('out'); var s=c.querySelector('.smoke'); if(s) s.remove();});
    surprise.classList.remove('show','bye'); surprise.setAttribute('aria-hidden','true');
    scene.classList.remove('open'); scene.setAttribute('aria-label','Birthday gift. Tap to open.');
    hint.textContent='tap the gift to open it';
  }

  function openGift(){
    if(scene.classList.contains('open')){ if(lit) resetGift(); return; }
    scene.classList.add('open'); scene.setAttribute('aria-label','Birthday cake');
    hint.textContent='blow out the candles: tap each one';
    chime();
    setTimeout(confetti,750);
    setTimeout(sidePop,900);
    rainStart=setTimeout(startRain,1600);
    timer=setTimeout(function(){lit=true;},2400);
  }
  scene.addEventListener('click',function(e){
    if(scene.classList.contains('open')&&!e.target.closest('.gift')) return;
    openGift();
  });
  scene.addEventListener('keydown',function(e){
    if(e.target===scene&&(e.key==='Enter'||e.key===' ')){e.preventDefault();openGift();}
  });


})();
</script>
</body>
</html>
